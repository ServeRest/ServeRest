{
  "name": "serverest",
  "version": "3.2.1",
  "description": "Servidor REST local de forma rápida e simples para estudo de testes de API",
  "author": "Paulo Gonçalves <author@serverest.dev> (https://www.linkedin.com/in/paulo-goncalves/)",
  "license": "GPL-3.0",
  "main": "./src/server.js",
  "bin": {
    "serverest": "src/server.js"
  },
  "files": [
    ".env",
    "docs/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ServeRest/ServeRest.git"
  },
  "homepage": "https://serverest.dev",
  "funding": {
    "type": "Open Collective",
    "url": "https://opencollective.com/serverest"
  },
  "keywords": [
    "testing",
    "server",
    "rest",
    "api"
  ],
  "scripts": {
    "prepare": "husky || true",
    "commit": "cz",
    "start": "node ./src/server.js",
    "start:debug": "node --inspect=0.0.0.0 ./src/server.js",
    "dev": "nodemon --legacy-watch -e json,js,css,svg ./src/server.js --nodoc",
    "test:mutation": "stryker run ./test/stryker.conf.js",
    "test:mutation:diff": "stryker-diff-runner --path ./test/stryker.conf.js --branch trunk",
    "test:unit": "nyc --report-dir ./coverage-unit --check-coverage false mocha --config test/unit/.mocharc.js",
    "test:integration": "nyc --report-dir ./coverage-integration mocha --config test/integration/.mocharc.js",
    "test:e2e": "mocha --config test/integration/.mocharc.js --fgrep @skipE2E --invert",
    "test:smoke": "mocha --config test/integration/.mocharc.js --grep @smokeE2E",
    "merge-lcov": "npx lcov-result-merger@3.1.0 'coverage-**/lcov.info' 'lcov.info'",
    "i18n:validate": "node ./scripts/i18n-validate.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "lint:staged": "lint-staged",
    "test:contract": "mocha test/contract --timeout 60000"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "colors": "^1.4.0",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.6",
    "dd-trace": "^5.85.0",
    "debug": "^4.4.3",
    "dotenv": "^17.2.4",
    "escape-string-regexp": "^5.0.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-ipfilter": "^1.4.0",
    "express-query-int": "^3.0.0",
    "express-status-monitor": "1.3.4",
    "express-validation": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "moesif-nodejs": "^3.11.0",
    "morgan": "^1.10.1",
    "nedb-promises": "^6.2.3",
    "open": "^11.0.0",
    "rate-limiter-flexible": "^9.1.0",
    "swagger-ui-express": "^5.0.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@codedependant/semantic-release-docker": "^5.1.1",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@faker-js/faker": "^10.2.0",
    "@hapi/joi": "^17.1.1",
    "@pact-foundation/pact": "^16.0.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.3",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@stryker-mutator/core": "^9.5.1",
    "chai": "^6.2.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "nock": "^14.0.10",
    "nodemon": "^3.1.11",
    "nyc": "^17.1.0",
    "semantic-release": "^25.0.3",
    "sinon": "^21.0.1",
    "standard": "^17.1.2",
    "stryker-diff-runner": "^2.3.11",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">= 22"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "standard": {
    "ignore": [
      "src/swagger/scripts/*.js"
    ],
    "globals": [
      "after",
      "afterEach",
      "before",
      "beforeEach",
      "describe",
      "it",
      "request"
    ]
  },
  "lint-staged": {
    "*.js": [
      "npm run lint:fix"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
